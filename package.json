{
  "name": "myclasses-teacher-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,vite \"npm:dev:api\" \"npm:dev:vite\"",
    "dev:api": "npm --prefix server run dev",
    "dev:vite": "npm --prefix frontend run dev",
    "build": "npm run build --prefix frontend && npm --prefix server run build",
    "start": "npm --prefix server start",
    "start:render": "npm run prisma:deploy && npm start",
    "typecheck": "npm run typecheck --prefix frontend && npm --prefix server run typecheck",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:deploy": "npm --prefix server run prisma:deploy"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
